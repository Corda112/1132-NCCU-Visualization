# 環境變數配置範例
# 複製此檔案為 .env 並修改配置值

# 開發環境API URL
REACT_APP_API_URL=http://localhost:3001

# 生產環境API URL (部署時使用)
# REACT_APP_API_URL=https://your-api-domain.com

# 其他配置
REACT_APP_APP_NAME=Bitcoin Sentiment Analysis
REACT_APP_VERSION=1.0.0

# 部署指南:
# 1. 開發環境: 使用 http://localhost:3001
# 2. 測試環境: 使用測試服務器URL
# 3. 生產環境: 使用正式API域名 